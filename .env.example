# Cookie de sesión de tu cuenta de Instagram (obtenida desde el navegador, ver README.md).
# Sin esto, la app solo intentará un modo anónimo muy limitado que suele no traer comentarios.
IG_SESSIONID=

# Opcionales, mejoran la fiabilidad de la sesión autenticada:
IG_DS_USER_ID=
IG_CSRFTOKEN=

# Opcional: API key de OpenAI (https://platform.openai.com/api-keys) para clasificar los comentarios
# con IA (positivos/negativos y filtros por tema). Sin ella se usa un análisis local por palabras
# clave, mucho menos preciso.
OPENAI_API_KEY=
# Opcional: modelo de OpenAI a usar (por defecto gpt-5.4-nano, el más económico).
OPENAI_MODEL=
